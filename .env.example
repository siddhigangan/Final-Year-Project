# ============================================================
# SecureCodeRAG Environment Configuration
# ============================================================
#
# Copy this file to .env for local development:
#
#     Copy-Item .env.example .env
#
# Never commit real API keys or secrets.
# ============================================================


# ------------------------------------------------------------
# Application / Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO
LOG_FILE=logs/app.log


# ------------------------------------------------------------
# Pipeline
# ------------------------------------------------------------

CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Number of chunks returned by the retriever.
TOP_K=5

# Enable optional retrieval reranking.
RERANKING_ENABLED=false


# ------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------

# Initial research baseline.
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=microsoft/unixcoder-base


# ------------------------------------------------------------
# Vector Store
# ------------------------------------------------------------

VECTORSTORE_PROVIDER=faiss
VECTORSTORE_PATH=data/processed/faiss_index


# ------------------------------------------------------------
# Code LLM
# ------------------------------------------------------------

# Primary local provider.
CODE_LLM_PROVIDER=ollama

# Model available through the local Ollama runtime.
CODE_LLM_MODEL=deepseek-coder:6.7b

# Ollama server URL.
CODE_LLM_BASE_URL=http://localhost:11434

# Alternative variable supported by the configuration layer.
OLLAMA_BASE_URL=http://localhost:11434


# ------------------------------------------------------------
# Optional Hosted LLM Fallback
# ------------------------------------------------------------

HOSTED_LLM_PROVIDER=openai
HOSTED_LLM_MODEL=gpt-4o-mini

# Add a real key only to your local .env file when required.
# OPENAI_API_KEY=


# ------------------------------------------------------------
# Data Directories
# ------------------------------------------------------------

CLEAN_DATA_DIR=data/clean
POISONED_DATA_DIR=data/poisoned
PROCESSED_DATA_DIR=data/processed
BENCHMARK_DIR=data/benchmarks


# ------------------------------------------------------------
# Results / Experiments
# ------------------------------------------------------------

RESULTS_DIR=results
EXPERIMENTS_DIR=experiments

SEED=42
EXPERIMENT_REPETITIONS=1
SAVE_INTERMEDIATE_RESULTS=true


# ------------------------------------------------------------
# Poisoning Research
# ------------------------------------------------------------

# Keep disabled during normal development.
POISONING_ENABLED=false

# Fraction used by controlled poisoning experiments.
POISONING_RATE=0.10


# ------------------------------------------------------------
# Defense Pipeline
# ------------------------------------------------------------

DEFENSE_ENABLED=true

# L1 - Source trust scoring
DEFENSE_TRUST_SCORING=true

# L2 - Suspicious / anomaly detection
DEFENSE_ANOMALY_DETECTION=true

# L3 - Retrieved-context validation
DEFENSE_CONTEXT_VALIDATION=true

# L4 - Instruction / data separation
DEFENSE_INSTRUCTION_SEPARATION=true

# L5 - Static analysis
DEFENSE_STATIC_ANALYSIS=true


# ------------------------------------------------------------
# Security Analysis
# ------------------------------------------------------------

STATIC_ANALYSIS_ENABLED=true

# Semgrep is optional and will be enabled after its integration.
SEMGREP_ENABLED=false


# ------------------------------------------------------------
# Optional API Keys
# ------------------------------------------------------------

# Hugging Face authentication is normally unnecessary for public
# models, but can be supplied when required.
# HUGGINGFACE_API_KEY=


# ------------------------------------------------------------
# Compatibility
# ------------------------------------------------------------
#
# Older repository configurations used RETRIEVAL_TOP_K.
# It remains supported by src.config, but TOP_K is preferred.
#
# RETRIEVAL_TOP_K=5