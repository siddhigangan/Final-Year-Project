# SecureCodeRAG Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Environment Setup
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Model Configurations (For future steps)
EMBEDDING_MODEL=text-embedding-3-small
CODE_LLM_MODEL=gpt-4o-mini
CODE_LLM_PROVIDER=openai

# API Keys (Placeholders - DO NOT commit real keys)
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_hf_api_key_here

# RAG Pipeline Configuration (For future steps)
VECTORSTORE_PATH=data/processed/faiss_index
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5

# Dataset Paths
CLEAN_DATA_DIR=data/clean
POISONED_DATA_DIR=data/poisoned
PROCESSED_DATA_DIR=data/processed
