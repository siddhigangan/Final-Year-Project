{
  "experiment_group": "baseline",
  "description": "Clean SecureCodeRAG baseline without defense layers.",
  "version": "1.0",
  "seed": 42,

  "conditions": [
    {
      "condition": "A_clean_no_defense",

      "dataset": {
        "type": "clean",
        "path": "data/clean"
      },

      "poisoning": {
        "enabled": false,
        "categories": []
      },

      "defense": {
        "enabled": false,
        "layers": []
      }
    }
  ],

  "tasks": [
    "code_generation",
    "code_completion",
    "bug_fixing",
    "test_generation",
    "api_usage",
    "repository_qa"
  ],

  "languages": [
    "python",
    "javascript",
    "java",
    "cpp"
  ],

  "retrieval": {
    "top_k": 5,
    "retriever": "default"
  },

  "generation": {
    "provider": "ollama",
    "temperature": 0.0,
    "max_tokens": 1024
  },

  "evaluation": {
    "calculate_poison_retrieval_rate": true,
    "calculate_attack_success_rate": true,
    "calculate_vulnerability_introduction_rate": true,
    "calculate_utility_score": true,
    "track_generation_changes": true,
    "run_security_analysis": true
  },

  "metadata": {
    "research_scope": "authorized_synthetic_code_rag_security",
    "corpus_type": "clean",
    "defense_enabled": false,
    "poisoning_enabled": false
  }
}